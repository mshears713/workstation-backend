# Copy this file to .env and fill in the blank secrets.
#
# Four are required for the live paths:
#   OPENAI_API_KEY  - transcription and TTS
#   OPENROUTER_API_KEY - the LLM behind every graph
#   NOTION_API_KEY  - Voice Inbox and van build log writes
#   GITHUB_TOKEN    - only if GO/issue creation is used
# The rest have working defaults and can be left alone.

# --- OpenRouter (model provider) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- LangSmith (optional tracing) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=operation-homebound-stage2
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- OpenAI (transcription + spoken notifications) ---
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTION_LANGUAGE=en
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# --- Notion (AI-OS destinations) ---
# Required: without it the voice-inbox and entries pipelines fail at the
# write step, after transcription has already happened.
NOTION_API_KEY=
# Defaults in app/config.py point at the current AI-OS databases; override
# only if those move.
NOTION_VOICE_INBOX_DATA_SOURCE_ID=
NOTION_SOURCES_DATA_SOURCE_ID=
NOTION_VAN_BUILD_LOG_DATA_SOURCE_ID=

# --- GitHub (voice-captured issues, see app/integrations/github_client.py) ---
# This token is why issue creation lives on the backend: it grants write
# access to real repositories and must never reach the ESP32. `gh auth token`
# prints a usable one if the GitHub CLI is already logged in. Needs `repo`
# scope. Only the repositories listed in config/projects.json can be written
# to, regardless of what the token itself can reach.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com

# --- Audio quality gate ---
AUDIO_CONFIDENCE_THRESHOLD=0.55

# --- App / persistence ---
DATA_DIR=data/runs
NOTES_DATA_DIR=data/notes
VOICE_INBOX_DATA_DIR=data/voice_inbox
NOTIFICATIONS_DATA_DIR=data/notifications
ENTRIES_DATA_DIR=data/entries
ISSUES_DATA_DIR=data/issues
STREAMING_TMP_DIR=data/_streaming_tmp
REVIEWER_MAX_ATTEMPTS=2
REQUEST_TIMEOUT_SECONDS=60

# Declared but not read - uvicorn is invoked externally, so the host/port
# come from its command line, not from here.
API_HOST=127.0.0.1
API_PORT=8000
